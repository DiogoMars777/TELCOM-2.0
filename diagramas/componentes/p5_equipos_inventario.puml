@startuml
title P5: Equipos, Proveedores e Inventario - Diagrama de componentes
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam componentStyle uml2
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #0F172A
}
skinparam database {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}

package "P5: Equipos, Proveedores e Inventario" {
  package "CU18 - Gestionar catálogo y unidades de equipos" as G1 {
    component "<<vista>>\nEquiposView.jsx" as V1
    component "<<controlador>>\nCatalogoEquiposController.php" as C1
    V1 --> C1 : API REST
    database "<<tabla>>\nProductoEquipo" as T1_1
    C1 ..> T1_1
    database "<<tabla>>\nInventario" as T1_2
    C1 ..> T1_2
    database "<<tabla>>\nEquipo" as T1_3
    C1 ..> T1_3
    database "<<tabla>>\nBitacora" as T1_4
    C1 ..> T1_4
  }

  package "CU19 - Asignar equipo en comodato" as G2 {
    component "<<vista>>\nAsignarEquipoComodatoView.jsx" as V2
    component "<<controlador>>\nAsignacionEquipoComodatoController.php" as C2
    V2 --> C2 : API REST
    database "<<tabla>>\nServicioInternet" as T2_1
    C2 ..> T2_1
    database "<<tabla>>\nEquipo" as T2_2
    C2 ..> T2_2
    database "<<tabla>>\nProductoEquipo" as T2_3
    C2 ..> T2_3
    database "<<tabla>>\nInventario" as T2_4
    C2 ..> T2_4
    database "<<tabla>>\nAsignacionEquipo" as T2_5
    C2 ..> T2_5
    database "<<tabla>>\nBitacora" as T2_6
    C2 ..> T2_6
  }

  package "CU20 - Reemplazar o retirar equipo" as G3 {
    component "<<vista>>\nEquipoReemplazoRetiroView.jsx" as V3
    component "<<controlador>>\nEquipoReemplazoRetiroController.php" as C3
    V3 --> C3 : API REST
    database "<<tabla>>\nServicioInternet" as T3_1
    C3 ..> T3_1
    database "<<tabla>>\nAsignacionEquipo" as T3_2
    C3 ..> T3_2
    database "<<tabla>>\nEquipo" as T3_3
    C3 ..> T3_3
    database "<<tabla>>\nProductoEquipo" as T3_4
    C3 ..> T3_4
    database "<<tabla>>\nBitacora" as T3_5
    C3 ..> T3_5
  }

}
@enduml
