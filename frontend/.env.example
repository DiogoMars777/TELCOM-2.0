# TELCOM - Frontend (Vite)
# Copia este archivo a `.env.local` y ajusta los valores si lo necesitas.
# NO pongas secretos reales en este archivo de ejemplo.

# URL base de la API de Laravel
# VITE_API_URL=http://localhost:8000/api

# Modo demostración (datos ficticios, sin backend). NUNCA en producción.
# VITE_DEMO_MODE=false

# --- Mapas (CU04 - Zonas de Cobertura) ---
# Proveedor de teselas del mapa. Es CONFIGURABLE para poder cambiarlo.
# Por defecto se usa OpenStreetMap. Ten en cuenta su política de uso:
#   https://operations.osmfoundation.org/policies/tiles/
# Los servidores públicos de OSM no garantizan disponibilidad ni uso ilimitado.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# VITE_MAP_MAX_ZOOM=19
